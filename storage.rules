rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
  // Extension list -> pattern for a file name ending in one of them,
  // optionally compressed (.br/.gz, as Unity and Godot builds ship).
  function webExt(list) {
    return '.*[.](' + list + ')([.](br|gz))?';
  }

  // Content type of the decompressed payload, matched to its extension.
  function isWebBuildFile(name, type) {
    return (name.matches(webExt('html|htm')) && type.matches('text/html(;.*)?'))
      || (name.matches(webExt('js|mjs')) && type.matches('(application|text)/javascript(;.*)?'))
      || (name.matches(webExt('css')) && type.matches('text/css(;.*)?'))
      || (name.matches(webExt('wasm')) && type.matches('application/(wasm|octet-stream)'))
      || (name.matches(webExt('data|unityweb|pck|apk')) && type == 'application/octet-stream')
      || (name.matches(webExt('json')) && type.matches('application/json(;.*)?'))
      || (name.matches(webExt('png|jpg|jpeg|gif|webp|svg|ico'))
          && type.matches('image/(png|jpeg|gif|webp|svg[+]xml|x-icon|vnd[.]microsoft[.]icon)'))
      || (name.matches(webExt('mp3|ogg|wav|m4a'))
          && type.matches('audio/(mpeg|ogg|wav|x-wav|wave|mp4|x-m4a)'))
      || (name.matches(webExt('woff|woff2|ttf|otf'))
          && type.matches('font/(woff|woff2|ttf|otf)|application/octet-stream'))
      || (name.matches(webExt('txt|fnt')) && type.matches('text/plain(;.*)?'))
      || (name.matches(webExt('xml')) && type.matches('(application|text)/xml(;.*)?'));
  }

    // Uploaded game builds: writable only by their author. Nobody reads them
    // directly; players get them through the `arcade` Cloud Function, which
    // enforces the school-hours lock (functions/arcade.js).
    //
    // Only web-build files, each with a content type that fits its
    // extension, so the folder can't host an .exe or other download that
    // skips the exec review of Windows builds. Keep in step with
    // WEB_BUILD_TYPES in scriptFolder/arcade-games.js.
    match /games/{uid}/{allPaths=**} {
      allow read: if false;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size < 100 * 1024 * 1024
                            && isWebBuildFile(request.resource.name.lower(),
                                              request.resource.contentType);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Windows download builds: one zip per game, uploaded once by its
    // author. Nobody reads them directly; the `arcade` function hands out
    // a 5-minute signed URL only for approved games while the Arcade is open.
    // No update or delete from clients, so an approved build can't be
    // swapped afterwards; the cleanUpDownloadBuild function deletes it when
    // the game is permanently removed from moderation.
    match /downloads/{uid}/{gameId}/build.zip {
      allow read: if false;
      // resource == null: only when no build exists yet.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && resource == null
                    && gameId.matches('^[-A-Za-z0-9_]{1,128}$')
                    && request.resource.size <= 500 * 1024 * 1024
                    && (request.resource.contentType == 'application/zip'
                        || request.resource.contentType == 'application/x-zip-compressed');
    }

    // Arcade card covers: one WebP per game, made in the browser by
    // scriptFolder/game-details.js. Public to read (cards show them during
    // the school-hours lock; they aren't game content). Unlike build.zip,
    // the owner may replace or delete their cover. The cleanUpDownloadBuild
    // function removes it when the game is permanently deleted.
    match /covers/{uid}/{gameId}/cover.webp {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && gameId.matches('^[-A-Za-z0-9_]{1,128}$')
                            && request.resource.contentType == 'image/webp'
                            && request.resource.size < 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Lesson cover images (Resources page). Public to read; each signed-in
    // user writes only their own folder. Raster images only (no SVG, which
    // can carry script). Which uploads end up attached to a lesson is
    // enforced by the database rules (approved members only).
    match /lesson-images/{uid}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && fileName.matches('^[0-9]{10,16}_[A-Za-z0-9._-]{1,100}$')
                    && fileName.lower().matches('.*[.](png|jpe?g|gif|webp)$')
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(png|jpeg|gif|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Lesson attachments. Code and text files are stored as text/plain and
    // served as downloads, so nothing uploaded here renders as a page.
    // HTML, SVG and JavaScript/TypeScript are not on the allowlist.
    match /lesson-files/{uid}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && fileName.matches('^[0-9]{10,16}_[A-Za-z0-9._-]{1,100}$')
                    && fileName.lower().matches('.*[.](zip|pdf|docx|pptx|txt|md|csv|json|py|java|c|cpp|h|hpp|cs|go|rs|rb|kt|swift|ipynb)$')
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('application/(zip|pdf|vnd[.]openxmlformats-officedocument[.](wordprocessingml[.]document|presentationml[.]presentation))|text/plain');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Sponsor logos: public, admin-only. Storage rules can't read the
    // Realtime Database, so `role` is a custom claim mirrored from
    // users/{uid}/role by the onRoleChange Cloud Function.
    match /sponsor-logos/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.token.role == 'admin'
                            && request.resource.size < 2 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && request.auth.token.role == 'admin';
    }
  }
}
