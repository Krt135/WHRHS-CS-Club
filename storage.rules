rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Uploaded game builds: public to play, writable only by their author
    match /games/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 100 * 1024 * 1024;
    }
  }
}
